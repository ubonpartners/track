#!/usr/bin/env bash
# Pre-commit guard: assert schema sentinels are present before letting the
# commit proceed. Catches the regression pattern where a careless
# `git checkout <ref> -- <path>` silently reverts in-flight v3 schema work
# and the next commit is made on top of the regressed tree.
#
# To bypass for a deliberate schema removal: `git commit --no-verify` and be
# very sure you know what you are doing. Removing a sentinel without
# updating ml/util/verify_tree_sentinels.py is almost always wrong.
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Only run on commits that touch schema-relevant files; cheap and avoids
# friction on unrelated commits (e.g. doc edits).
if git diff --cached --name-only | grep -qE '(pair_log_schema\.py|build_state_corpus\.py|train_state_head_decoupled\.py|train_phase3\.py|build_pair_dataset\.py|_artefact_meta\.py|nn_state\.h|utrack_state\.c|utrack_internal\.h|utrack_match\.c)$'; then
    python ml/util/verify_tree_sentinels.py
fi
